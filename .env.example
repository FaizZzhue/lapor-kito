# ============================================================
# LAPORKITO — Environment Variables Configuration
# ============================================================
# Copy this file to .env.local and fill in the corresponding values.

# ------------------------------------------------------------
# 1. Supabase Configuration (Database, Auth, Storage)
# ------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. Gemini AI Configuration (Triage, Classification, Verification)
# ------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------
# 3. Resend Configuration (Email Notifications)
# ------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789...
RESEND_FROM_EMAIL=LAPORKITO <onboarding@resend.dev>

# ------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CITY_NAME="Kota Palembang"
NEXT_PUBLIC_DEFAULT_LAT=-2.976073
